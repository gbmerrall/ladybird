// https://gpuweb.github.io/gpuweb/#gpurenderpassencoder
[Exposed=Window, SecureContext, ImplementedIn=Rust]
interface GPURenderPassEncoder {
    undefined setPipeline(GPURenderPipeline pipeline);

    // FIXME: The overload that takes dynamic offsets in a Uint32Array.
    undefined setBindGroup([EnforceRange] unsigned long index, GPUBindGroup? bindGroup,
        optional sequence<[EnforceRange] unsigned long> dynamicOffsets = []);

    undefined setIndexBuffer(GPUBuffer buffer, GPUIndexFormat indexFormat, optional GPUSize64 offset = 0,
        optional GPUSize64 size);
    undefined setVertexBuffer([EnforceRange] unsigned long slot, GPUBuffer? buffer, optional GPUSize64 offset = 0,
        optional GPUSize64 size);

    undefined draw([EnforceRange] unsigned long vertexCount, optional [EnforceRange] unsigned long instanceCount = 1,
        optional [EnforceRange] unsigned long firstVertex = 0, optional [EnforceRange] unsigned long firstInstance = 0);
    undefined drawIndexed([EnforceRange] unsigned long indexCount, optional [EnforceRange] unsigned long instanceCount = 1,
        optional [EnforceRange] unsigned long firstIndex = 0, optional [EnforceRange] long baseVertex = 0,
        optional [EnforceRange] unsigned long firstInstance = 0);
    undefined drawIndirect(GPUBuffer indirectBuffer, GPUSize64 indirectOffset);
    undefined drawIndexedIndirect(GPUBuffer indirectBuffer, GPUSize64 indirectOffset);

    undefined setViewport(float x, float y, float width, float height, float minDepth, float maxDepth);
    undefined setScissorRect([EnforceRange] unsigned long x, [EnforceRange] unsigned long y,
        [EnforceRange] unsigned long width, [EnforceRange] unsigned long height);
    undefined setBlendConstant(GPUColor color);
    undefined setStencilReference([EnforceRange] unsigned long reference);

    undefined beginOcclusionQuery([EnforceRange] unsigned long queryIndex);
    undefined endOcclusionQuery();

    undefined executeBundles(sequence<GPURenderBundle> bundles);

    undefined end();
};

GPURenderPassEncoder includes GPUObjectBase;
